# LLM for fact-checking
ANTHROPIC_API_KEY=sk-ant-...

# Web search provider for claim verification (tavily | serper | brave)
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=tvly-...

# Database connection. SQLite (default, dev) or PostgreSQL (production):
#   sqlite:///data/db.sqlite3
#   postgresql+psycopg://user:pass@host:5432/factcheck
DB_URL=sqlite:///data/db.sqlite3

# Optional: use a pre-installed Chromium instead of Playwright's own download
# (container images, CI runners with pinned browser builds).
# CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
