# ---------------------------------------------------------------------------
# LLM backend — set the one matching `factcheck.provider` in config.yaml
# ---------------------------------------------------------------------------

# Gemini (default). Free tier via Google AI Studio: https://aistudio.google.com/apikey
# Free limits are 10 requests/minute and 250/day; the pipeline uses two calls
# per article, so roughly 125 articles a day.
GEMINI_API_KEY=

# Anthropic — alternative backend, paid. Set factcheck.provider: anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Web search — supplies the evidence every verdict must cite
# ---------------------------------------------------------------------------

# perplexity | tavily | serper
SEARCH_PROVIDER=perplexity

# Perplexity (https://docs.perplexity.ai) is usage-billed; Pro subscribers get
# monthly API credits. Tavily (https://tavily.com) has a free tier if you would
# rather keep the whole pipeline at zero cost — switch SEARCH_PROVIDER=tavily.
SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# SQLite (default, dev) or PostgreSQL (production):
#   sqlite:///data/db.sqlite3
#   postgresql+psycopg://user:pass@host:5432/factcheck
DB_URL=sqlite:///data/db.sqlite3

# Optional: use a pre-installed Chromium instead of Playwright's own download
# (container images, CI runners with pinned browser builds).
# CHROMIUM_EXECUTABLE_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
